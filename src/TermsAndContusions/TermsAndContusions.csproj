<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>TermsAndContusions</AssemblyName>
    <RootNamespace>TermsAndContusions</RootNamespace>
    <Version>1.1.1</Version>
    <DefineConstants>$(DefineConstants);TC_EMBEDDED_CAMERA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ChainedBeasts.FirstPerson\*.cs" Exclude="..\ChainedBeasts.FirstPerson\Plugin.cs" Link="FirstPerson\%(Filename)%(Extension)" />
    <Reference Include="Cinemachine"><HintPath>$(BepInExRoot)\interop\Cinemachine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(BepInExRoot)\interop\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(BepInExRoot)\interop\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\ChainedBeasts.ModFoundation\ChainedBeasts.ModFoundation.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
