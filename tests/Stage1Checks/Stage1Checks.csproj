<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <ChainedBeastsGameDir Condition="'$(ChainedBeastsGameDir)' == '' and '$(CHAINED_BEASTS_GAME_DIR)' != ''">$(CHAINED_BEASTS_GAME_DIR)</ChainedBeastsGameDir>
    <ChainedBeastsGameDir Condition="'$(ChainedBeastsGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Chained Beasts</ChainedBeastsGameDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the production config logic without loading Unity or IL2CPP. -->
    <Compile Include="..\..\src\ChainedBeasts.ModFoundation\Configuration\*.cs" Link="Production\%(Filename)%(Extension)" />
    <Reference Include="BepInEx.Core">
      <HintPath>$(ChainedBeastsGameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
